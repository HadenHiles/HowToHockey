{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://howtohockey.com/schemas/drill-catalog.schema.json",
  "title": "How To Hockey drill catalog",
  "type": "object",
  "required": ["schemaVersion", "drills"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "drills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/drill"
      }
    }
  },
  "$defs": {
    "drill": {
      "type": "object",
      "required": [
        "id",
        "title",
        "mediaAssetPath",
        "formCues",
        "trackingType",
        "allowedLocations",
        "minPuckInventory",
        "requiresPasser",
        "skillWeights",
        "tier",
        "supportedBalls",
        "passerTypes",
        "defaultPrescription",
        "estimatedSecondsPerSet",
        "difficulty",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "mediaAssetPath": {
          "description": "Path relative to the sibling media directory; uploaded to Storage at the same object path.",
          "type": "string",
          "pattern": "^drills/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.mp4$"
        },
        "formCues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trackingType": {
          "enum": ["volume", "duration", "density", "accuracy", "streak", "binary"]
        },
        "allowedLocations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ice", "roller", "drivewayGarage", "basement", "syntheticIce"]
          }
        },
        "minPuckInventory": {
          "enum": ["low", "medium", "high"]
        },
        "requiresPasser": {
          "type": "boolean"
        },
        "skillWeights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "shooting": { "type": "number", "minimum": 0, "maximum": 1 },
            "stickhandling": { "type": "number", "minimum": 0, "maximum": 1 },
            "skating": { "type": "number", "minimum": 0, "maximum": 1 },
            "passing": { "type": "number", "minimum": 0, "maximum": 1 },
            "iqConditioning": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "tier": {
          "enum": ["free", "pro"]
        },
        "supportedBalls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["golfBall", "trainingBall", "greenBiscuit"]
          }
        },
        "passerTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["rebounder", "partner"]
          }
        },
        "defaultPrescription": {
          "type": "object",
          "required": ["sets", "restSeconds"],
          "additionalProperties": false,
          "properties": {
            "sets": { "type": "integer", "minimum": 1 },
            "reps": { "type": "integer", "minimum": 1 },
            "seconds": { "type": "integer", "minimum": 1 },
            "restSeconds": { "type": "integer", "minimum": 0 },
            "targetLabel": { "type": "string", "minLength": 1 }
          }
        },
        "estimatedSecondsPerSet": {
          "type": "integer",
          "minimum": 1
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "swapGroup": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    }
  }
}
