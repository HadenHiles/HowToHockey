rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A kid device signs in with a custom token that carries a `profileId` claim. It can act as that
    // one profile only: never the parent's account, billing, or the child's siblings.
    function signedIn() {
      return request.auth != null;
    }

    function isKidDevice() {
      return signedIn() && 'profileId' in request.auth.token;
    }

    function ownsProfile(profileId) {
      return signedIn() && !isKidDevice() && get(/databases/$(database)/documents/profiles/$(profileId)).data.ownerUid == request.auth.uid;
    }

    function canActAs(profileId) {
      return isKidDevice() ? request.auth.token.profileId == profileId : ownsProfile(profileId);
    }

    function validSession(data) {
      return data.keys().hasOnly(['status', 'startedAt', 'endedAt', 'tzOffsetMinutes', 'routineName', 'setup', 'focus', 'drillCount', 'activeSeconds', 'programRunId'])
        && data.keys().hasAll(['status', 'startedAt', 'endedAt', 'tzOffsetMinutes'])
        && data.status in ['completed', 'pending']
        && data.startedAt is timestamp
        && data.endedAt is timestamp
        && data.tzOffsetMinutes is int && data.tzOffsetMinutes >= -840 && data.tzOffsetMinutes <= 840
        && (!('drillCount' in data) || (data.drillCount is int && data.drillCount >= 0 && data.drillCount <= 50))
        && (!('activeSeconds' in data) || (data.activeSeconds is int && data.activeSeconds >= 0 && data.activeSeconds <= 86400))
        && (!('programRunId' in data) || (data.programRunId is string && data.programRunId.size() > 0 && data.programRunId.size() <= 128))
        && (!('routineName' in data) || (data.routineName is string && data.routineName.size() <= 80));
    }

    function validSessionDrill(data) {
      return data.keys().hasOnly(['drillId', 'title', 'trackingType', 'skillWeights', 'estimatedSecondsPerSet', 'sets'])
        && data.keys().hasAll(['drillId', 'sets'])
        && data.drillId is string && data.drillId.size() > 0 && data.drillId.size() < 100
        && data.sets is list && data.sets.size() <= 100
        && (!('title' in data) || (data.title is string && data.title.size() <= 80))
        && (!('estimatedSecondsPerSet' in data) || (data.estimatedSecondsPerSet is int && data.estimatedSecondsPerSet >= 1 && data.estimatedSecondsPerSet <= 600));
    }

    // Account documents (roles, entitlements) are written only by Cloud Functions.
    match /users/{uid} {
      allow read: if signedIn() && !isKidDevice() && request.auth.uid == uid;
      allow write: if false;
      match /teamRequests/{requestId} {
        allow read: if signedIn() && !isKidDevice() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    function canReadTeam(data) {
      return signedIn() && (isKidDevice()
        ? request.auth.token.profileId in data.memberProfileIds
        : request.auth.uid in data.coachUids || request.auth.uid in data.memberOwnerUids);
    }

    match /teamDirectory/{teamId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /teams/{teamId} {
      allow read: if canReadTeam(resource.data);
      allow write: if false;
      match /members/{profileId} {
        allow read: if canReadTeam(get(/databases/$(database)/documents/teams/$(teamId)).data);
        allow write: if false;
      }
      match /joinRequests/{profileId} {
        allow read: if signedIn() && !isKidDevice()
          && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.coachUids;
        allow write: if false;
      }
    }

    // Profiles are created and edited only through Cloud Functions, which validate names and enforce
    // the child-profile cap. Clients can read the profiles they own, or the one their kid device is locked to.
    match /profiles/{profileId} {
      // An account's own profile has the account's ID. It may be read before it exists, so a screen that starts
      // watching it right after sign-up isn't cut off while the profile is still being created.
      allow read: if signedIn() && (isKidDevice()
        ? request.auth.token.profileId == profileId
        : (resource == null ? request.auth.uid == profileId : resource.data.ownerUid == request.auth.uid));
      allow write: if false;

      // A finished workout is written once. A child's device can only write it as `pending`: a parent confirms
      // it (flipping `status` to `completed`) or discards it, and only then does the Cloud Function credit it.
      // `processedAt` and `credit` are added by the function; clients can't set them, so they can't award themselves anything.
      match /sessions/{sessionId} {
        allow read: if canActAs(profileId);
        allow create: if canActAs(profileId) && validSession(request.resource.data) && (request.resource.data.status == 'pending' || !isKidDevice());
        allow update: if ownsProfile(profileId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt'])
          && request.resource.data.confirmedAt == request.time;
        allow delete: if ownsProfile(profileId) && resource.data.status == 'pending';

        // Who changed a workout, when, and what it was before. Written only by the correction function.
        match /audits/{auditId} {
          allow read: if ownsProfile(profileId);
          allow write: if false;
        }

        match /drills/{index} {
          allow read: if canActAs(profileId);
          allow create: if canActAs(profileId) && index.matches('[0-9]{1,2}') && validSessionDrill(request.resource.data);
          allow update: if false;
          allow delete: if ownsProfile(profileId) && get(/databases/$(database)/documents/profiles/$(profileId)/sessions/$(sessionId)).data.status == 'pending';
        }
      }

      // Routines a parent saves for a child: library drills and set counts. Written only by Cloud Functions, which keep the free-plan cap.
      match /routines/{routineId} {
        allow read: if canActAs(profileId);
        allow write: if false;
      }

      // Program access is resolved by a callable against the profile owner's billing record. Progress is
      // written only by the session processor; a paired device can read only its own profile's progress.
      match /programs/{programId} {
        allow read: if canActAs(profileId);
        allow write: if false;
      }

      match /programRuns/{runId} {
        allow read, write: if false;
      }

      // Totals and personal bests are computed by Cloud Functions.
      match /stats/{doc} {
        allow read: if canActAs(profileId);
        allow write: if false;
      }

      match /prs/{prKey} {
        allow read: if canActAs(profileId);
        allow write: if false;
      }

      match /focusPresets/{presetId} {
        allow read, write: if canActAs(profileId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
